{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoongg.github.io/Moonrise-Catalog/schema/index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "signatureStatus", "packages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "signatureStatus": {"enum": ["unsignedDevelopment", "signedProduction"]},
    "packages": {"type": "array"}
  }
}
